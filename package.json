{
  "name": "browserarena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nottelabs/browserarena.git"
  },
  "homepage": "https://browserarena.ai",
  "bugs": {
    "url": "https://github.com/nottelabs/browserarena/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "description": "remote browser benchmark",
  "main": "index.js",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "bench": "npm run build && node dist/cli.js",
    "test": "tsx --test src/providers/*.test.ts src/benchmarks/*/*.test.ts",
    "check-regressions": "npm --prefix web run check-regressions --"
  },
  "author": "junhsss <junhsssr@gmail.com>",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@browserbasehq/sdk": "^2.19.0",
    "anchorbrowser": "^0.16.3",
    "steel-sdk": "^0.18.0",
    "@hyperbrowser/sdk": "^0.71.0",
    "@onkernel/sdk": "^0.110.0",
    "dotenv": "^17.4.2",
    "playwright-core": "^1.62.1"
  }
}
