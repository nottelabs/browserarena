{
  "name": "browserarena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nottelabs/browserarena.git"
  },
  "homepage": "https://browserarena.ai",
  "bugs": {
    "url": "https://github.com/nottelabs/browserarena/issues"
  },
  "engines": {
    "node": ">=20.20.2"
  },
  "description": "remote browser benchmark",
  "main": "index.js",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "bench": "npm run build && node dist/cli.js",
    "test": "tsx --test src/providers/*.test.ts src/benchmarks/*/*.test.ts",
    "check-regressions": "npm --prefix web run check-regressions --"
  },
  "author": "junhsss <junhsssr@gmail.com>",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@browserbasehq/sdk": "^2.20.0",
    "anchorbrowser": "^1.0.0",
    "steel-sdk": "^0.18.0",
    "@hyperbrowser/sdk": "^1.0.3",
    "@onkernel/sdk": "^0.119.0",
    "dotenv": "^18.0.6",
    "playwright-core": "^1.64.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1144.0",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.4"
  }
}
