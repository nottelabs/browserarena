# Copy to `.env` and set keys only for the providers you run (`npm run bench -- --provider=...`).
# See README.md for flags and defaults.

# Browserbase
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Steel
STEEL_API_KEY=

# Kernel
KERNEL_API_KEY=

# Notte
NOTTE_API_KEY=

# Hyperbrowser
HYPERBROWSER_API_KEY=

# Anchor Browser
ANCHORBROWSER_API_KEY=

# Browser Use (cloud)
BROWSER_USE_API_KEY=

# --- Optional CLI defaults (same as flags on `npm run bench` / `npm run dev`) ---
# BENCHMARK=hello-browser
# PROVIDER=browserbase
# RUNS=100
# URL=https://example.com/
# OUTPUT=
# RATE=
# CONCURRENCY=1

# Proxy GET benchmark (BENCHMARK=proxy-get; defaults to 50 attempts/country)
# PROXY_COUNTRIES=US,FR,BR,IN,JP
# PROXY_BOOTSTRAP_URL=https://www.browserarena.ai/api/proxy-get/bootstrap
# PROXY_COUNTRY_URL=https://api.country.is/
# PROXY_PRICING_FILE=path/to/pricing.json

# Tilion (beta) — request a key at tilion.dev
TILION_API_KEY=
TILION_BASE_URL=https://tilion-control.fly.dev

# Lightpanda — sessions are created on CDP connect. Defaults to us-west.
LIGHTPANDA_API_KEY=
# LIGHTPANDA_CDP_URL=wss://euwest.cloud.lightpanda.io/ws

# Browserless — sessions are created on CDP connect. Defaults to the shared US West (SFO) fleet.
BROWSERLESS_API_KEY=
# BROWSERLESS_CDP_URL=wss://production-lon.browserless.io

# Cloudflare Browser Run — needs a Workers Paid plan and an API token with "Browser Rendering - Edit".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# GoLogin Cloud Browser — dev token from Personal Area → API Token. Plans allow 1–3 parallel sessions.
GOLOGIN_API_TOKEN=

# Amazon Bedrock AgentCore Browser — credentials come from the standard AWS chain
# (the keys below, shared config, or an instance role) and need
# bedrock-agentcore:StartBrowserSession, StopBrowserSession and ConnectBrowserAutomationStream.
AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
